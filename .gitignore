# Node artifact files
node_modules/
dist/
log/
results/
eval/results_*.csv
checkpoints/
isaacgym/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log
wandb/

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.tiff
*.avi
*.flv
*.mov
*.wmv
*.mp4
*.webm
*.mkv
*.gif
!docs/static/images/*.gif
!docs/static/videos/*.mp4
!docs/static/videos/*.webm
!docs/static/videos/*.gif

# VS Code
.vscode
# logs
logs
runs

# other
*.egg-info
__pycache__
.agents/
.codex/
.omc/
.omx/
/COMMANDS_KR.md
/NOTES.md
/todo.md
*.ckpt
*.pth
*.pt
